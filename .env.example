# Recall — Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================================================
# CockroachDB Cloud (Required for production)
# ============================================================================

# CockroachDB Cloud connection string
# Get this from: cockroachlabs.cloud → Cluster → Connect → Connection string
COCKROACH_DB_URL=postgresql://user:password@cluster.cockroachlabs.cloud:26257/recall?sslmode=verify-full

# CockroachDB Cloud cluster ID (for ccloud CLI commands)
CRDB_CLUSTER_ID=your-cluster-id

# CockroachDB Cloud API key (for MCP Server read-only access)
# Get this from: cockroachlabs.cloud → Settings → API Keys
CRDB_API_KEY=your-api-key

# ============================================================================
# AWS Services (Required for production)
# ============================================================================

# AWS region for Lambda, Bedrock, and S3
AWS_REGION=us-east-1

# AWS credentials (IAM user with access to Bedrock, Lambda, S3)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 bucket for conversation artifacts (transcripts, snapshots, reflections)
AWS_S3_BUCKET=recall-artifacts

# ============================================================================
# Supabase (Used for demo fallback — Postgres-compatible with pgvector)
# ============================================================================

# These are pre-populated in the Bolt environment
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# Optional: CockroachDB Agent Skills
# ============================================================================
# The Agent Skills repo provides machine-executable skills for CockroachDB
# expertise: https://github.com/cockroachdb/agent-skills
# Clone and reference in your agent's skill configuration
